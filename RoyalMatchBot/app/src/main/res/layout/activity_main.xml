<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cor_fundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem_padrao">

        <!-- Header com logo e título -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="Logo Royal Match Bot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titulo_principal"
                android:textColor="@color/cor_texto_destaque"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subtitulo_principal"
                android:textColor="@color/cor_texto_secundario"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Card de Status Principal -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/cor_card_fundo"
            app:cardCornerRadius="@dimen/raio_card"
            app:cardElevation="@dimen/elevacao_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STATUS DO BOT"
                    android:textColor="@color/cor_texto_secundario"
                    android:textSize="12sp"
                    android:letterSpacing="0.15"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <View
                        android:id="@+id/indicadorStatus"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@drawable/indicador_status"
                        android:backgroundTint="@color/cor_inativo" />

                    <TextView
                        android:id="@+id/txtStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/status_inativo"
                        android:textColor="@color/cor_texto_primario"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <!-- Informações rápidas da sessão -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/txtFasesHoje"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/cor_texto_destaque"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fases Hoje"
                            android:textColor="@color/cor_texto_secundario"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/cor_card_borda"
                        android:layout_marginHorizontal="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/txtTaxaSucesso"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="@color/cor_ativo"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Taxa Sucesso"
                            android:textColor="@color/cor_texto_secundario"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/cor_card_borda"
                        android:layout_marginHorizontal="8dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/txtTempoSessao"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textColor="@color/cor_processando"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tempo Sessão"
                            android:textColor="@color/cor_texto_secundario"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Botões de Controle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIniciar"
                android:layout_width="0dp"
                android:layout_height="@dimen/altura_botao"
                android:layout_weight="1"
                android:text="@string/btn_iniciar"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"
                app:backgroundTint="@color/cor_btn_iniciar"
                app:cornerRadius="@dimen/raio_botao"
                app:icon="@android:drawable/ic_media_play" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnParar"
                android:layout_width="0dp"
                android:layout_height="@dimen/altura_botao"
                android:layout_weight="1"
                android:text="@string/btn_parar"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:enabled="false"
                app:backgroundTint="@color/cor_btn_parar"
                app:cornerRadius="@dimen/raio_botao"
                app:icon="@android:drawable/ic_media_pause" />
        </LinearLayout>

        <!-- Card de Permissões -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPermissoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="#3D1A00"
            app:cardCornerRadius="@dimen/raio_card"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Configuração Necessária"
                    android:textColor="#FFB300"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutPermAcessibilidade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp"
                    android:padding="12dp"
                    android:background="@drawable/bg_permissao_item">

                    <TextView
                        android:id="@+id/iconePermAcessibilidade"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:text="✗"
                        android:textColor="@color/cor_inativo"
                        android:textSize="18sp"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Serviço de Acessibilidade"
                            android:textColor="@color/cor_texto_primario"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Necessário para controlar o jogo"
                            android:textColor="@color/cor_texto_secundario"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAtivarAcessibilidade"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ativar"
                        android:textSize="12sp"
                        app:strokeColor="@color/cor_secundaria"
                        android:textColor="@color/cor_secundaria" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutPermOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp"
                    android:padding="12dp"
                    android:background="@drawable/bg_permissao_item">

                    <TextView
                        android:id="@+id/iconePermOverlay"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:text="✗"
                        android:textColor="@color/cor_inativo"
                        android:textSize="18sp"
                        android:gravity="center" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Exibir sobre outros apps"
                            android:textColor="@color/cor_texto_primario"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Necessário para mostrar o painel"
                            android:textColor="@color/cor_texto_secundario"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAtivarOverlay"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Permitir"
                        android:textSize="12sp"
                        app:strokeColor="@color/cor_secundaria"
                        android:textColor="@color/cor_secundaria" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card de Configuração Rápida -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/cor_card_fundo"
            app:cardCornerRadius="@dimen/raio_card"
            app:cardElevation="@dimen/elevacao_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONFIGURAÇÃO RÁPIDA"
                    android:textColor="@color/cor_texto_secundario"
                    android:textSize="12sp"
                    android:letterSpacing="0.15"
                    android:textStyle="bold" />

                <!-- Velocidade -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Velocidade"
                        android:textColor="@color/cor_texto_primario"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/spinnerVelocidade"
                        android:layout_width="160dp"
                        android:layout_height="40dp"
                        android:backgroundTint="@color/cor_card_borda"
                        android:spinnerMode="dropdown" />
                </LinearLayout>

                <!-- Estratégia -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Estratégia"
                        android:textColor="@color/cor_texto_primario"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/spinnerEstrategia"
                        android:layout_width="160dp"
                        android:layout_height="40dp"
                        android:backgroundTint="@color/cor_card_borda"
                        android:spinnerMode="dropdown" />
                </LinearLayout>

                <!-- Toggles -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Usar Boosters"
                        android:textColor="@color/cor_texto_primario"
                        android:textSize="14sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchBoosters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Anti-Detecção"
                        android:textColor="@color/cor_texto_primario"
                        android:textSize="14sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAntiDeteccao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Botões de Navegação -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEstatisticas"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Estatísticas"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"
                app:strokeColor="@color/cor_card_borda"
                android:textColor="@color/cor_texto_primario"
                app:cornerRadius="@dimen/raio_botao" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfiguracoes"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Configurações"
                android:textSize="12sp"
                android:layout_marginHorizontal="4dp"
                app:strokeColor="@color/cor_card_borda"
                android:textColor="@color/cor_texto_primario"
                app:cornerRadius="@dimen/raio_botao" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogs"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Logs"
                android:textSize="12sp"
                android:layout_marginStart="4dp"
                app:strokeColor="@color/cor_card_borda"
                android:textColor="@color/cor_texto_primario"
                app:cornerRadius="@dimen/raio_botao" />
        </LinearLayout>

        <!-- Card de Último Log -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/cor_card_fundo"
            app:cardCornerRadius="@dimen/raio_card"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ÚLTIMA ATIVIDADE"
                    android:textColor="@color/cor_texto_secundario"
                    android:textSize="12sp"
                    android:letterSpacing="0.15"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtUltimoLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nenhuma atividade registrada"
                    android:textColor="@color/cor_texto_secundario"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:maxLines="5"
                    android:ellipsize="end" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
