<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="@drawable/bg_item_fase">

    <TextView
        android:id="@+id/txtNumeroFase"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:background="@drawable/bg_numero_fase"
        android:textColor="@color/cor_fundo"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtResultadoFase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONCLUÍDA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/cor_ativo" />

            <TextView
                android:id="@+id/txtMovimentosFase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="23 movimentos"
                android:textSize="12sp"
                android:textColor="@color/cor_texto_secundario" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/txtTempoFase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1m 23s"
                android:textSize="11sp"
                android:textColor="@color/cor_texto_secundario" />

            <TextView
                android:id="@+id/txtBoostersFase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="2 boosters"
                android:textSize="11sp"
                android:textColor="@color/cor_texto_secundario" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/txtDataFase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="14:32"
        android:textSize="11sp"
        android:textColor="@color/cor_texto_secundario" />
</LinearLayout>
