LOG_CHANNEL_ID=
WELCOME_CHANNEL_ID=
ANNOUNCE_CHANNEL_ID=
TICKET_CATEGORY_ID=
STAFF_ROLE_ID=

# Ponte HTTP (MTA -> Discord)
BRIDGE_PORT=3750
BRIDGE_SECRET=troque-esta-chave-secreta-longa

# IDs de usuários com acesso total ao painel (separados por vírgula)
BOT_OWNER_IDS=
