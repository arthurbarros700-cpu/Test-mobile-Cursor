<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="16dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Seção: Desempenho -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ DESEMPENHO"
                    style="@style/LabelEstatistica"
                    android:layout_marginBottom="16dp" />

                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Velocidade de Jogo"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <Spinner android:id="@+id/spinnerVelocidade"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_spinner"
                    android:entries="@array/velocidades_array"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="16dp" />

                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estratégia"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <Spinner android:id="@+id/spinnerEstrategia"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_spinner"
                    android:entries="@array/estrategias_array"
                    android:layout_marginBottom="16dp" />

                <TextView android:id="@+id/tvIntervaloJogadas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="800ms entre jogadas"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <SeekBar android:id="@+id/seekbarIntervaloJogadas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="30"
                    android:progress="6"
                    android:layout_marginBottom="16dp"
                    android:progressTint="@color/primary_light"
                    android:thumbTint="@color/secondary" />

                <TextView android:id="@+id/tvDelayAnimacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1200ms aguardando animação"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <SeekBar android:id="@+id/seekbarDelayAnimacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="30"
                    android:progress="10"
                    android:progressTint="@color/primary_light"
                    android:thumbTint="@color/secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Seção: Comportamento -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎮 COMPORTAMENTO"
                    style="@style/LabelEstatistica"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchUsarBoosters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Usar Boosters Automaticamente"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchColetarRecompensas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Coletar Recompensas Diárias"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchModoSigilo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🕵️ Modo Sigilo (movimentos humanizados)"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchIniciarComSistema"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Iniciar com o Sistema"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="16dp" />

                <TextView android:id="@+id/tvLimiteHoras"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sem limite de horas"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <SeekBar android:id="@+id/seekbarLimiteHoras"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="24"
                    android:progress="0"
                    android:progressTint="@color/primary_light"
                    android:thumbTint="@color/secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Seção: Notificações e Logs -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔔 NOTIFICAÇÕES E LOGS"
                    style="@style/LabelEstatistica"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchNotifFase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Notificar ao completar fase"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchNotifErros"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Notificar erros"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSalvarLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Salvar logs no dispositivo"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    android:layout_marginBottom="16dp" />

                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nível de Log"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <Spinner android:id="@+id/spinnerNivelLog"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_spinner"
                    android:entries="@array/niveis_log_array" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botões de ação -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalvar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp"
            android:text="✅ Salvar Configurações"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_light"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRedefinir"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="24dp"
            android:text="🔄 Redefinir Padrões"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="@color/text_hint"
            android:textColor="@color/text_secondary"
            app:cornerRadius="12dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
